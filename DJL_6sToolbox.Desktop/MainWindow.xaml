<Window x:Class="DJL_6sToolbox.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:DJL_6sToolbox.Desktop.Models"
        xmlns:vm="clr-namespace:DJL_6sToolbox.Desktop.ViewModels"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="DJL_6's 工具箱"
        Width="1100" Height="700"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="NavTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Icon}" FontSize="16" Width="28" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontSize="15" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="LogTemplate">
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Time, StringFormat=HH:mm:ss}"
                           Foreground="{StaticResource TextSecondaryBrush}" Width="58" />
                <TextBlock Grid.Column="1" Text="·" Margin="8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Success}">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Warning}">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Error}">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="14" Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Height="44" Background="Transparent" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,0">
                    <TextBlock Text="DJL_6's 工具箱" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="B站自动化工具" Margin="10,0,0,0" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Button Style="{StaticResource WindowButton}" Content="─" Click="Minimize_OnClick" />
                    <Button Style="{StaticResource WindowButton}" Content="□" Click="Maximize_OnClick" />
                    <Button Style="{StaticResource CloseWindowButton}" Content="✕" Click="Close_OnClick" />
                </StackPanel>
            </Grid>

            <!-- 主体 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 侧边栏 -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,18,16,18">
                            <TextBlock Text="◈" FontSize="26" Foreground="{StaticResource PrimaryBrush}" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ciallo～(∠・ω&lt; )⌒★" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="v1.0.0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding NavItems}"
                                 SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource NavTemplate}"
                                 ItemContainerStyle="{StaticResource NavItemStyle}"
                                 Background="Transparent" BorderThickness="0" />

                        <StackPanel Grid.Row="2" Margin="20,0,20,18">
                            <TextBlock Text="{Binding LoginStatus}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LoginDetail}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 主内容 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 顶栏状态 -->
                    <Grid Grid.Row="0" Margin="28,18,28,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedNav.Title}" Style="{StaticResource H1}" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="已点赞" Style="{StaticResource SecondaryText}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalLiked}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"
                                       FontFamily="Segoe UI, Microsoft YaHei UI" Margin="0,-2,0,0" />
                            <TextBlock Text="  ·  " Style="{StaticResource SecondaryText}" Margin="12,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TopRightStatusText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" ScrollChanged="MainScroll_OnScrollChanged"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="28,10,28,24">
                        <StackPanel>
                            <!-- ========== 总览 ========== -->
                            <Grid x:Name="DashboardPage" Visibility="Visible">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="欢迎使用 DJL_6's 工具箱" Style="{StaticResource H2}" />
                                            <TextBlock Margin="0,8,0,0" Style="{StaticResource SecondaryText}"
                                                       TextWrapping="Wrap"
                                                       Text="自动扫描 B 站全站最新投稿，并按 UP 主粉丝数、等级筛选后点赞。支持定时运行、系统托盘与一键更新。" />
                                            <TextBlock Margin="0,10,0,0" Style="{StaticResource SecondaryText}"
                                                       TextWrapping="Wrap"
                                                       Text="“启动自动点赞”= 按设定间隔持续运行；“立即扫描并点赞一次”= 只执行一轮，不进入定时循环。" />
                                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                <Button Content="{Binding StartStopText}" Style="{StaticResource PrimaryButton}"
                                                        Command="{Binding StartStopCommand}" Margin="0,0,10,0" />
                                                <Button Content="立即扫描并点赞一次" Style="{StaticResource AccentButton}"
                                                        Command="{Binding RunOnceCommand}" IsEnabled="{Binding CanRunOnce}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="点赞方式" Style="{StaticResource H2}" />
                                                    <TextBlock Text="当前方式：" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
                                                    <TextBlock Text="{Binding CurrentLikeMethodText}" FontSize="20" FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="纯网页" Width="120" Height="38" Margin="0,0,8,0"
                                                            Command="{Binding SetLikeMethodWebCommand}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWebMethod}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                                        <Setter Property="Foreground" Value="White" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="移动端竖屏" Width="120" Height="38" Margin="0,0,8,0"
                                                            Command="{Binding SetLikeMethodMobileCommand}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMobileMethod}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                        <Setter Property="Foreground" Value="White" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="APP 签名" Width="120" Height="38"
                                                            Command="{Binding SetLikeMethodAppCommand}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAppMethod}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                                        <Setter Property="Foreground" Value="White" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <CheckBox Style="{StaticResource SwitchStyle}" Margin="0,12,0,0"
                                                      IsChecked="{Binding Settings.EnableLikeModeSwitch, Mode=TwoWay}"
                                                      Content="失败时自动切换模式（纯网页 → 移动端竖屏 → APP 签名）" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="运行状态" Style="{StaticResource H2}" />
                                                <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0" FontSize="16" />
                                                <TextBlock Text="{Binding LastRunText}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
                                                <TextBlock Text="累计已点赞" Style="{StaticResource SecondaryText}" Margin="0,18,0,0" />
                                                <TextBlock Text="{Binding TotalLiked}" FontSize="30" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="运行日志" Style="{StaticResource H2}" />
                                                <ListBox ItemsSource="{Binding Logs}" ItemTemplate="{StaticResource LogTemplate}"
                                                         MaxHeight="260" Margin="0,10,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="4" Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="人机自动验证" Style="{StaticResource H2}" />
                                                <CheckBox Style="{StaticResource SwitchStyle}" Margin="0,8,0,0"
                                                          IsChecked="{Binding Settings.CaptchaEnabled, Mode=TwoWay}"
                                                          Content="启用自动人机验证" />
                                                <Image Source="{Binding CaptchaImageSource}" MaxHeight="130" Margin="0,8,0,0"
                                                       Stretch="Uniform" />
                                                <wv2:WebView2 x:Name="CaptchaWebView" Height="160" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding CaptchaProgressText}" Style="{StaticResource SecondaryText}"
                                                           Margin="0,6,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="人机验证日志" Style="{StaticResource H2}" Margin="0,10,0,0" />
                                                <ListBox ItemsSource="{Binding CaptchaLogs}" ItemTemplate="{StaticResource LogTemplate}"
                                                         MaxHeight="120" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- ========== 自动点赞 ========== -->
                            <Grid x:Name="AutoLikePage" Visibility="Collapsed">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="定时自动点赞" Style="{StaticResource H2}" />
                                                    <TextBlock Text="开启后按设定间隔扫描全站最新投稿，自动为符合条件的视频点赞。" Margin="0,6,0,0"
                                                               Style="{StaticResource SecondaryText}" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                                          IsChecked="{Binding Settings.AutoLikeEnabled, Mode=TwoWay}"
                                                          Content="启用" VerticalAlignment="Center" />
                                            </Grid>

                                            <Grid Margin="0,18,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="扫描间隔（秒）" Style="{StaticResource SecondaryText}" />
                                                    <TextBox Text="{Binding Settings.ScanIntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="每次扫描页数" Style="{StaticResource SecondaryText}" />
                                                    <TextBox Text="{Binding Settings.MaxPages, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="每轮最多点赞" Style="{StaticResource SecondaryText}" />
                                                    <TextBox Text="{Binding Settings.MaxLikesPerRun, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="点赞最小间隔（秒）" Style="{StaticResource SecondaryText}" />
                                                    <TextBox Text="{Binding Settings.MinLikeDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="点赞最大间隔（秒）" Style="{StaticResource SecondaryText}" />
                                                    <TextBox Text="{Binding Settings.MaxLikeDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="风控冷却（分钟）" Style="{StaticResource SecondaryText}" />
                                                    <TextBox Text="{Binding Settings.RiskControlCooldownMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"
                                                          IsChecked="{Binding Settings.UseMobilePortraitLike, Mode=TwoWay}"
                                                          Content="移动端竖屏模式" />
                                                <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"
                                                          IsChecked="{Binding Settings.UseAppSignedLike, Mode=TwoWay}"
                                                          Content="APP 签名请求" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SecondaryText}"
                                                           Text="模拟 m.bilibili.com / Android 客户端环境。" />
                                                                                        </Grid>

                                            <CheckBox Style="{StaticResource SwitchStyle}" Margin="0,16,0,0"
                                                      IsChecked="{Binding Settings.PreventSleepWhileRunning, Mode=TwoWay}"
                                                      Content="自动点赞时防止系统休眠" />

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                                <Button Content="保存设置" Style="{StaticResource BaseButton}" Command="{Binding SaveSettingsCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="手机设备环境" Style="{StaticResource H2}" />
                                                    <TextBlock Text="可配置多套手机环境，按时间自动轮换。" Margin="0,6,0,0"
                                                               Style="{StaticResource SecondaryText}" />
                                                    <TextBlock Text="{Binding CurrentPhoneDisplay}" Margin="0,4,0,0" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="新增环境" Style="{StaticResource BaseButton}"
                                                            Command="{Binding AddPhoneProfileCommand}" Margin="0,0,8,0" />
                                                    <Button Content="删除环境" Style="{StaticResource BaseButton}"
                                                            Command="{Binding RemovePhoneProfileCommand}" />
                                                    <Button Content="切换到此设备" Style="{StaticResource AccentButton}"
                                                            Command="{Binding ApplyPhoneProfileCommand}" Margin="0,0,8,0" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          VerticalAlignment="Top"
                                                          ItemsSource="{Binding PhoneProfiles}"
                                                          SelectedItem="{Binding SelectedPhoneProfile, Mode=TwoWay}"
                                                          PreviewMouseWheel="OnComboBoxPreviewMouseWheel" DropDownOpened="OnComboBoxDropDownOpened">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <StackPanel Grid.Column="2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="16" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="环境名称" Style="{StaticResource SecondaryText}" />
                                                            <TextBox Text="{Binding SelectedPhoneProfile.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Text="每轮赞数上限" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                                                            <TextBox Text="{Binding SelectedPhoneProfile.MaxLikesPerRun, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" />
                                                            <TextBlock Text="AccessKey" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                                                            <TextBox Text="{Binding SelectedPhoneProfile.AccessKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Text="DeviceId" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                                                            <TextBox Text="{Binding SelectedPhoneProfile.DeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Text="BuvidFp" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                                                            <TextBox Text="{Binding SelectedPhoneProfile.BuvidFp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Text="Buvid3" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                                                            <TextBox Text="{Binding SelectedPhoneProfile.Buvid3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Text="Buvid" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                                                            <TextBox Text="{Binding SelectedPhoneProfile.Buvid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Text="Buvid4" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                                                            <TextBox Text="{Binding SelectedPhoneProfile.Buvid4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Build" Style="{StaticResource SecondaryText}" />
                                                            <TextBox Text="{Binding SelectedPhoneProfile.Build, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Text="Channel" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                                                            <TextBox Text="{Binding SelectedPhoneProfile.Channel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Text="DeviceBrand" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                                                            <TextBox Text="{Binding SelectedPhoneProfile.DeviceBrand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Text="DeviceModel" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                                                            <TextBox Text="{Binding SelectedPhoneProfile.DeviceModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Text="OsVersion" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                                                            <TextBox Text="{Binding SelectedPhoneProfile.OsVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Text="BiliTicket" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                                                            <TextBox Text="{Binding SelectedPhoneProfile.BiliTicket, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Text="BiliTicketV2" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                                                            <TextBox Text="{Binding SelectedPhoneProfile.BiliTicketV2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Text="ADB 序列号（可选）" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                                                            <TextBox Text="{Binding SelectedPhoneProfile.AdbSerial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="ADB 设备" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="2" VerticalAlignment="Center"
                                                          ItemsSource="{Binding AdbDevices}"
                                                          SelectedItem="{Binding SelectedAdbDevice, Mode=TwoWay}"
                                                          PreviewMouseWheel="OnComboBoxPreviewMouseWheel" DropDownOpened="OnComboBoxDropDownOpened">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Grid.Column="3" Content="使用此ADB设备" Style="{StaticResource AccentButton}"
                                                        Command="{Binding ApplyAdbDeviceCommand}" Margin="8,0,0,0" />
                                            </Grid>
                                            <TextBlock Text="{Binding CurrentAdbDisplay}" Margin="0,8,0,0" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding AdbStatusText}" Margin="0,4,0,0" Style="{StaticResource SecondaryText}" />
                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center"
                                                          IsChecked="{Binding Settings.EnablePhoneRotation, Mode=TwoWay}"
                                                          Content="启用定时轮换" />
                                                <TextBlock Grid.Column="2" Text="轮换间隔（分钟）" Style="{StaticResource SecondaryText}"
                                                           VerticalAlignment="Center" />
                                                <TextBox Grid.Column="3" Width="80" TextAlignment="Right"
                                                         Text="{Binding Settings.PhoneRotationMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Margin="8,0,0,0" />
                                                <Button Grid.Column="5" Content="保存设置" Style="{StaticResource BaseButton}"
                                                        Command="{Binding SaveSettingsCommand}" />
                                            </Grid>
                                            <CheckBox Style="{StaticResource SwitchStyle}" Margin="0,16,0,0"
                                                      IsChecked="{Binding Settings.EnableAdbBridge, Mode=TwoWay}"
                                                      Content="启用 ADB 请求桥（可选）" />
                                            <CheckBox Style="{StaticResource SwitchStyle}" Margin="0,12,0,0"
                                                      IsChecked="{Binding Settings.AdbFollowPhoneSwitch, Mode=TwoWay}"
                                                      Content="ADB 跟随系统切换" />
                                        </StackPanel>
                                    </Border>


                                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="筛选条件" Style="{StaticResource H2}" />
                                            <TextBlock Text="0 表示不限制。筛选会实时请求 UP 主卡片，建议合理设置以减少风控。" Margin="0,6,0,0"
                                                       Style="{StaticResource SecondaryText}" />

                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="UP主最少粉丝" Style="{StaticResource SecondaryText}" />
                                                    <TextBox Text="{Binding Settings.MinFans, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="UP主最多粉丝" Style="{StaticResource SecondaryText}" />
                                                    <TextBox Text="{Binding Settings.MaxFans, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="UP主最低等级" Style="{StaticResource SecondaryText}" />
                                                    <TextBox Text="{Binding Settings.MinLevel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="6">
                                                    <TextBlock Text="UP主最高等级" Style="{StaticResource SecondaryText}" />
                                                    <TextBox Text="{Binding Settings.MaxLevel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="标题包含关键词（空格分隔）" Style="{StaticResource SecondaryText}" />
                                                    <TextBox Text="{Binding Settings.TitleKeywords, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="标题排除关键词（空格分隔）" Style="{StaticResource SecondaryText}" />
                                                    <TextBox Text="{Binding Settings.ExcludeKeywords, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                                <Button Content="保存设置" Style="{StaticResource BaseButton}" Command="{Binding SaveSettingsCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="{Binding StartStopText}" Style="{StaticResource PrimaryButton}"
            
                                                Command="{Binding StartStopCommand}" Margin="0,0,10,0" />
                                        <Button Content="立即扫描并点赞一次" Style="{StaticResource AccentButton}"
                                                Command="{Binding RunOnceCommand}" IsEnabled="{Binding CanRunOnce}" Margin="0,0,10,0" />
                                    </StackPanel>
                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource SecondaryText}"
                                               Text="“启动自动点赞”会按设定间隔持续运行；“立即扫描并点赞一次”只执行一轮，适合测试筛选条件。" />
                                </StackPanel>
                            </Grid>

                            <!-- ========== 原版功能 ========== -->
                            <Grid x:Name="SearchPage" Visibility="Collapsed">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="原版搜索任务" Style="{StaticResource H2}" />
                                            <TextBlock Text="按关键词搜索视频，可执行点赞 / 评论 / 举报。每项操作之间带随机延时以降低风控。" Margin="0,6,0,0"
                                                       Style="{StaticResource SecondaryText}" />

                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="搜索关键词" Style="{StaticResource SecondaryText}" />
                                                    <TextBox Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="处理数量" Style="{StaticResource SecondaryText}" />
                                                    <TextBox Text="{Binding SearchCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="执行动作" Style="{StaticResource SecondaryText}" />
                                                    <ComboBox SelectedItem="{Binding SearchAction, Mode=TwoWay}"
                                                              ItemsSource="{Binding SearchActions}"
                                                              PreviewMouseWheel="OnComboBoxPreviewMouseWheel" DropDownOpened="OnComboBoxDropDownOpened" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="评论内容（每行一条，随机选用）" Style="{StaticResource SecondaryText}" />
                                                    <TextBox Text="{Binding CommentText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                                                             VerticalScrollBarVisibility="Auto" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="举报原因" Style="{StaticResource SecondaryText}" />
                                                    <ComboBox ItemsSource="{Binding ReportReasons}"
                                                              SelectedValuePath="Key"
                                                              DisplayMemberPath="Value"
                                                              SelectedValue="{Binding ReportReason, Mode=TwoWay}"
                                                              PreviewMouseWheel="OnComboBoxPreviewMouseWheel" DropDownOpened="OnComboBoxDropDownOpened" />
                                                    <TextBlock Text="举报补充说明" Style="{StaticResource SecondaryText}" Margin="0,12,0,0" />
                                                    <TextBox Text="{Binding ReportDetail, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                                                             VerticalScrollBarVisibility="Auto" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                <Button Content="执行搜索任务" Style="{StaticResource PrimaryButton}"
                                                        Command="{Binding RunSearchTaskCommand}"
                                                        IsEnabled="{Binding CanRunSearch}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- ========== Cookie ========== -->
                            <Grid x:Name="CookiePage" Visibility="Collapsed">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="B 站 Cookie" Style="{StaticResource H2}" />
                                            <TextBlock Text="从浏览器登录 B 站后，复制完整 Cookie 字符串粘贴到下方。程序仅保存在本机。" Margin="0,6,0,0"
                                                       Style="{StaticResource SecondaryText}" />
                                            <TextBox Text="{Binding Settings.Cookie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="140" AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Button Content="从浏览器自动获取 Cookie" Style="{StaticResource AccentButton}"
                                                        Command="{Binding AutoFetchCookieCommand}" Margin="0,0,10,0" />
                                                <Button Content="保存并验证" Style="{StaticResource PrimaryButton}"
                                                        Command="{Binding SaveCookieCommand}" Margin="0,0,10,0" />
                                                <Button Content="保存所有设置" Style="{StaticResource BaseButton}"
                                                        Command="{Binding SaveSettingsCommand}" Margin="0,0,10,0" />
                                                <Button Content="打开 GitHub 查看获取方法" Style="{StaticResource BaseButton}"
                                                        Command="{Binding OpenGitHubCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="登录状态" Style="{StaticResource H2}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding LoginStatus}" Margin="10,0,0,0" FontSize="15" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding LoginDetail}" Style="{StaticResource SecondaryText}" Margin="20,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- ========== 关于更新 ========== -->
                            <Grid x:Name="SettingsPage" Visibility="Collapsed">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="关于 DJL_6's 工具箱" Style="{StaticResource H2}" />
                                            <TextBlock Text="基于 https://github.com/greedisgoood/bilibili-tool 的现代化 Windows 桌面版。" Margin="0,8,0,0"
                                                       Style="{StaticResource SecondaryText}" />
                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="当前版本" Style="{StaticResource SecondaryText}" />
                                                    <TextBlock Text="v1.0.0" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="更新状态" Style="{StaticResource SecondaryText}" />
                                                    <TextBlock Text="{Binding UpdateText}" FontSize="14" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="更新设置" Style="{StaticResource H2}" />
                                            <CheckBox Style="{StaticResource SwitchStyle}" Margin="0,14,0,0"
                                                      IsChecked="{Binding Settings.AutoCheckUpdate, Mode=TwoWay}"
                                                      Content="启动时自动检查更新" />
                                            <CheckBox Style="{StaticResource SwitchStyle}" Margin="0,14,0,0"
                                                      IsChecked="{Binding Settings.AutoStartOnBoot, Mode=TwoWay}"
                                                      Content="开机自启动（静默托盘运行）" />
                                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                                <Button Content="立即检查更新" Style="{StaticResource AccentButton}"
                                                        Command="{Binding CheckUpdateCommand}" Margin="0,0,10,0" />
                                                <Button Content="打开 GitHub 仓库" Style="{StaticResource BaseButton}"
                                                        Command="{Binding OpenGitHubCommand}" Margin="0,0,10,0" />
                                                <Button Content="保存所有设置" Style="{StaticResource BaseButton}"
                                                        Command="{Binding SaveSettingsCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
